{
  "name": "network-visualizer",
  "version": "1.0.0",
  "description": "AI-powered network map visualizer built with Electron and React",
  "main": "dist-electron/main.js",
  "author": {
    "name": "st3114 gr33n",
    "email": "155259551+st311a-gr33n@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/AugustGray/Electron_Network-Visualizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@google/genai",
      "protobufjs",
      "phantomjs-prebuilt"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm build:electron",
    "build:electron": "mkdir -p dist-electron && tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/",
    "preview": "vite preview",
    "electron:dev": "pnpm build:electron && concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "pnpm build && electron-builder",
    "electron:build:linux": "pnpm build && electron-builder --linux",
    "electron:build:win": "pnpm build && electron-builder --win",
    "electron:build:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "animejs": "^4.5.0",
    "d3": "^7.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-icon-builder": "^2.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.networkvisualizer.app",
    "productName": "Network Visualizer",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    }
  }
}
